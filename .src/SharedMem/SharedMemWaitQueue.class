Export
'Fast Unsafe

Private WaitQueue As Variant[] = New Variant[]                ' we will queue wait requests here
Public $oShm As Variant = Null                                ' The SharedMemory object

' A notification is a key written into the notify pipe of the waiting process, /dev/shm/sharedmem-notify-<pid>,
' KeyNew or KeyChanged, after an event was put on its queue (see QueueEvent). The process watches its pipe, so the
' File_Read event calls the notify functions as soon as the event loop runs: in any Wait, or when the program
' returns to the loop. A busy program gets them at its next SharedMem read, write or Exist (CheckSignal).
Private Const NotifyPipePrefix As String = "/dev/shm/sharedmem-notify-"
Private Const KeyChanged As String = "C"                      ' written to the pipe: a variable we wait for changed
Private Const KeyNew As String = "N"                          ' a variable was made, an event is on our queue
Private Const KeyDeleted As String = "D"                      ' a variable was freed, an event is on our queue
Private Const PipeFull As Integer = 1024                      ' this many bytes waiting: nothing more is written, the reader does both
Private $bKeyNew As Boolean                                   ' the keys DrainNotifyPipe read
Private $bKeyChanged As Boolean
Private $bKeyAll As Boolean                                   ' a full pipe: check every variable
Private hNotify As File = Null                                ' our notify pipe, open while we wait for changes
Private $iNotifyPid As Integer = 0                            ' the process that opened hNotify, a forked Task inherits it
Private bDelivering As Boolean = False                        ' a notify function that uses SharedMem does not deliver again

' Each process that waits for notifications has its own queue of events in the variable memory. The table
' #notifyq lists the queues, QSlots entries of 16 bytes: Integer pid at 0, Integer 0 at 4, Long queue offset at 8.
' A queue is a Long count of entries written at 0, a Long count read at 8, an Integer count of new and deleted
' variable events dropped at 16, an Integer count of change events dropped at 20, a Long index of the first entry
' of the last event at 24, then QSize entries of 16 bytes. A new or changed event is one entry: Integer kind
' (QKindNew, QKindChanged) at 0, Integer symbol table slot at 4, Long slot generation at 8, it points to its
' variable in the table. A deleted event, QKindDeleted, carries the name, the slot may be used again at once:
' Integer kind, Integer name length, then the name and a zero in the entries after it.
' Each variable has the list of the processes waiting for it in its symbol table slot (ShmSymbolTable.Waiters):
' an Integer count, an Integer capacity, then the pids, after the allocation header. NotifyNew waits on #newvar,
' so its list holds the processes waiting for new variables; NotifyDeleted waits on #delnotifyq. SharedMem._put adds the events under its lock to the
' queues of the processes in the list of the variable, and writes their key, KeyNew or KeyChanged, to their pipes. The process takes the events from its queue and calls the notify functions of
' those variables. A change event for the variable of the last event not read yet is not added again. A full
' queue drops its oldest event and counts it: the reader checks every variable after dropped changes, and
' reports the new variables it could not name
Private $pQTable As Pointer = 0                               ' offset of the table, 0 before _begin
Private $pMyQ As Pointer = 0                                  ' offset of our queue, 0 when we have none
Private $iMyQPid As Integer = 0                               ' the process that made $pMyQ, a forked Task inherits it
Private $aSignalNew As New Integer[]                          ' processes QueueEvent gave a new variable, SignalQueued wakes them
Private $aSignalChanged As New Integer[]                      ' processes QueueEvent gave a change
Private $aSignalDeleted As New Integer[]                      ' processes QueueDeleted gave a deleted variable
Private Const QSlots As Integer = 64
Private Const QSize As Integer = 1024
Private Const QHeader As Integer = 32
Private Const QEntry As Integer = 16
Private $cMyWaits As New Collection                           ' slot:generation -> number of our waits for that variable
Private $iMyWaitsPid As Integer = 0                           ' the process $cMyWaits belongs to, a forked Task inherits it
Private Const WaitersFirst As Integer = 16                    ' pids in a new list, it doubles when full
Public Const QKindNew As Integer = 1
Public Const QKindChanged As Integer = 2
Public Const QKindDeleted As Integer = 3

Public Struct WaitHeader
  pid As Integer
  OldTime As Float
  timeout As Long
  sym As SharedMemSymbol
  CallBack As Object
  CallBackClass As String
  Method As String
End Struct

Extern getpid() As Integer In "libc:6"
Extern sched_yield() As Integer In "libpthread:0"
Extern memcpyString(dest As Pointer, src As String, Len As Integer) As Pointer In "libc:6" Exec "memcpy"

'' Return a printable list of objects waiting for a notification
'' of value change for a specific symbol name. For all PIDs
Public Sub GetWhoWaiting(sym As String) As String

  Dim result As String = " "

  result = "\n  [ Timeout, Last Write Time, PID of requesting Task, Callback Method,  Object Class Name ]"
  For Each s As Waitheader In WaitQueue
    If s.sym.symname = sym Then
      result &= Subst("\n  [ &1, &2, &3, &4, &5 ]", CStr(s.timeout), CStr(s.oldtime), CStr(s.pid), s.method, s.CallBackClass)
      Break
    Endif
  Next

  If result = "" Then result = "\n  [ UnKnown timeout, UnKnow last Time, UnKnown Pid, Unknown Method, Unknown Object]"

  Return result

End

'' return a printable list of all objects and symbols  waiting for a notification of value change
'' for all PIDs
Public Sub NotifyList() As String[]

  Dim result As New String[]

  For Each s As Waitheader In WaitQueue
    result.Add(Subst(" &6  [ &1, &2, &3, &4, &5 ]", CStr(s.timeout), CStr(s.oldtime), CStr(s.pid), s.method, s.CallBackClass, s.sym.symname))
  Next

  Return result

End

'' Stop the NotifyDeleted calls for NotifyObject
Public Sub NotifyDelCanceled(NotifyObject As Variant)

  NotifyCancel("#delnotifyq", NotifyObject)

End

'' Notify when a variable is freed, in any process: FunctionName(Name As String), var_deleted by default
Public Sub NotifyDeleted(NotifyObject As Variant, Optional FunctionName As String = "") As Boolean

  Return NotifyChange("#delnotifyq", NotifyObject, -1, FunctionName)

End

'' Cancel Notify New
Public Sub NotifyNewCancel(NotifyObject As Variant)

  NotifyCancel("#newvar", NotifyObject)

End


'' Notify when a variable changes value or is created
Public Sub NotifyNew(NotifyObject As Variant, Optional FunctionName As String = "OnNew") As Boolean

  Return NotifyChange("#newvar", NotifyObject, -1, FunctionName)

End


'' NotifyChange(Symbol As String, NotifyObject As Object, Optional iTimeOut As Long = 0, FunctionName As String = "") As Boolean
'' timeout can be  = 0 = wait forever until first occurance          call _change
''                 < 0 = notify me everytime a location changes      call _change
''                 > 0 wait for timeout and                          call _nochange
'' call function names can be overridden by providing function name
'' waiting for a timeout is very slow and you must execute a wait in your bg task to dispatch the timeout
'' Place an entry into the list of applications waiting to be notified of a change in a variable
Public Sub NotifyChange(Symbol As String, NotifyObject As Variant, Optional iTimeOut As Long = 0, FunctionName As String = "") As Boolean

  Dim FuncName As String = FunctionName
  Dim MyWait As WaitHeader = New WaitHeader

  If Not SharedMem.Exist(Symbol) Then
    Error.Raise("Wait Change: Symbol not found : " & Symbol)
    Return False
  Endif

  'Dim fName As String
  If symbol = "#newvar" And If FuncName = "" Then
    FuncName = "newvar_created"
  Else If symbol = "#delnotifyq" And If FuncName = "" Then
    FuncName = "var_deleted"
  Else If FuncName = "" Then
    FuncName = Symbol & "_changed"
  Endif

  Dim mClass As Class = Null

  Dim cClass As Class
  For Each cClass In classes
    If NotifyObject = cClass Then
      mClass = cClass
      Break
    Endif
  Next

  If IsNull(mClass) Then
    mClass = Object.class(NotifyObject)
  Endif

  MyWait.CallBackClass = mClass.name

  If Not mClass.Exist(FuncName) Then
    Error.Raise("Call Back Function (" & FuncName & ") not found")
    Return False
  Endif

  MyWait.sym = SharedMem.SymbolTable[Symbol]
  MyWait.CallBack = NotifyObject
  MyWait.Method = FuncName
  MyWait.pid = getpid()

  MyWait.timeout = iTimeout
  OpenQueue()                                               ' our event queue, raises when the table is full

  WaitQueue.Add(MyWait)
  AddWaiter(MyWait.sym)                                     ' our pid in the list of the variable

  MyWait.sym.setLastWrite()
  MyWait.OldTime = MyWait.sym.getLastWrite()              ' only a write from now on is a change. Now + Timer never equalled it: every wait fired once at once

  OpenNotifyPipe()
  'Error "Notify change for :"; Symbol;; "For PID="; MyWait.pid
  Return True

Catch
  Error.Raise("Notify Change Error pid = " & Str(getpid()) & " : " & Error.text & " " & Error.where)
  Return False

End

'' Notify cancel
'' Cancel a wait for a specific symbol value change, for the current pid
Public Sub NotifyCancel(Symbol As String, NotifyObject As Object)

  Dim MyWait As WaitHeader
  Dim i As Integer = 0

  For Each mywait In WaitQueue
    If (mywait.CallBack = NotifyObject Or NotifyObject = Null) And If mywait.sym.SymName = symbol Then
      WaitQueue.Remove(i)
      If MyWait.pid = getpid() Then RemoveWaiter(MyWait.sym)
      Break
    Endif
    Inc i
  Next
  CloseQueueIfIdle()                                        ' no wait left: the queue is closed

End

'' Initialize the local wait queue and optionally set the
'' shared memory segment to which it refers
Public Sub _new(Optional vshm As Variant)

  'Print "init wait queue"

  WaitQueue = New Variant[]
  $oShm = vshm

End

'' clear the local wait queue
Public Sub reset()

  WaitQueue = New Variant[]

End

'' Find or make the table of notify queues, #notifyq
Public Sub _begin()

  With sharedmem

    Dim memoryloc As Pointer

    $pQTable = 0                                            ' QueueEvent does nothing until the table exists
    $pMyQ = 0
    If Not .Exist("#notifyq") Then
      memoryloc = .ShmAlloc(.AllocHeaderLen + QSlots * 16)
      Dim pTable As Pointer = QData(memoryloc)               ' after the allocation header
      For iSlot As Integer = 0 To QSlots * 2 - 1
        Long@(pTable + iSlot * 8) = 0
      Next
      .["#notifyq"] = memoryloc
    Else
      memoryloc = .["#notifyq"]
    Endif
    $pQTable = memoryloc

  End With

End

'' Remove the Application from the list of applications waiting for a notification
Public Sub Dofree()

  For Each MyWait As WaitHeader In WaitQueue               ' out of the lists of the variables
    If MyWait.pid = getpid() Then RemoveWaiter(MyWait.sym)
  Next
  CloseQueue()
  CloseNotifyPipe()

End

'' Open our notify pipe, read and write so it never reports end of file when a writer closes it
Private Sub OpenNotifyPipe()

  DropInheritedPipe()
  If hNotify <> Null Then Return
  For Each sName As String In Dir("/dev/shm", "sharedmem-notify-*")   ' pipes left by processes that crashed
    If Not Exist("/proc/" & Mid(sName, Len("sharedmem-notify-") + 1)) Then Try Kill "/dev/shm" &/ sName
  Next
  hNotify = Open Pipe NotifyPipePrefix & CStr(getpid()) For Read Write Watch
  $iNotifyPid = getpid()

End

'' A forked Task inherits the pipe of its parent: close our copy without reading it, the bytes are for the
'' parent. The pipe file stays, it is the parent's
Private Sub DropInheritedPipe()

  If hNotify = Null Or If $iNotifyPid = getpid() Then Return
  Try Close hNotify
  hNotify = Null
  $iNotifyPid = 0

End

Private Sub CloseNotifyPipe()

  DropInheritedPipe()
  If hNotify = Null Then Return
  Try Close hNotify
  hNotify = Null
  Try Kill NotifyPipePrefix & CStr(getpid())

End

'' A change came in: the event loop calls this as soon as a byte is in our notify pipe
Public Sub File_Read()

  DropInheritedPipe()
  DrainNotifyPipe()
  If bDelivering Then Return
  bDelivering = True
  Deliver($bKeyNew, $bKeyChanged, $bKeyAll)
  bDelivering = False

End

'' Read the keys waiting in our pipe: N new variables, C changes. A pipe that was full means both, and check
'' every variable: keys were not written
Private Sub DrainNotifyPipe()

  Dim sData As String
  Dim iTotal As Integer

  $bKeyNew = False
  $bKeyChanged = False
  $bKeyAll = False
  If hNotify = Null Then Return
  While Lof(hNotify) > 0
    Try sData = Read #hNotify, -256
    If Error Then Break
    iTotal += Len(sData)
    If InStr(sData, KeyNew) Then $bKeyNew = True
    If InStr(sData, KeyChanged) Then $bKeyChanged = True
  Wend
  If iTotal >= PipeFull Then $bKeyAll = True
  If $bKeyAll Then
    $bKeyNew = True
    $bKeyChanged = True
  Endif

End

'' Write sKey into the pipe of process Pid: KeyChanged or KeyNew. False when the process is gone
Private Sub NotifyPid(Pid As Integer, sKey As String) As Boolean

  Dim sPipe As String = NotifyPipePrefix & CStr(Pid)
  Dim hPipe As File

  If Not Exist("/proc/" & CStr(Pid)) Then                   ' the process ended without End
    Try Kill sPipe
    Return False
  Endif
  If Not Exist(sPipe) Then Return True                      ' it has no pipe open now. Open Pipe would make one
  Try hPipe = Open Pipe sPipe For Write                     ' never blocks
  If Error Then Return True
  If Lof(hPipe) < PipeFull Then Try Write #hPipe, sKey, 1   ' more waiting: the reader does both, the pipe never fills
  Try Close hPipe
  Return True

End

'' True when this process waits for a notification
Public Sub HasWaits() As Boolean

  Return WaitQueue.Count > 0

End

'' Call the notify functions when a change signal came in. SharedMem calls it at the start of _get, _put and
'' Exist, SharedMem.CheckNotify calls it for a program that waits without using SharedMem
Public Sub CheckSignal()

  If bDelivering Or If WaitQueue.Count = 0 Then Return
  DropInheritedPipe()
  If hNotify = Null Or If Lof(hNotify) = 0 Then Return     ' nothing came in
  DrainNotifyPipe()                                         ' the event loop did not run yet, a busy program
  bDelivering = True
  Deliver($bKeyNew, $bKeyChanged, $bKeyAll)
  bDelivering = False

End

'' Call the notify functions of this process whose variable changed. There can be individual
'' entry points for each symbol, or all the same entry point.
'' Not Fast: an error of a notify function is caught here, the JIT crashed on errors caught across JIT functions
Private Sub Deliver(bNew As Boolean, bChanged As Boolean, bAll As Boolean)

  Dim MyWait As WaitHeader
  Dim Counter As Integer = 0
  Dim vReturn As Variant

  'Error "recieved signal! pid="; application.id

  If WaitQueue.count = 0 Then Return
  'Error "Wait Queue not empty!"

  Dim aNew As New String[]                                  ' the variables made since the last call, for NotifyNew
  Dim aDeleted As New String[]                              ' the variables freed since the last call, for NotifyDeleted
  Dim cChanged As New Collection                            ' slot:generation of the variables that changed
  If TakeEvents(aNew, cChanged, aDeleted) Then bAll = True  ' events were dropped: check every variable
  If bAll Then bChanged = True

  For counter = WaitQueue.max DownTo 0

    mywait = WaitQueue[counter]

    If MyWait.pid <> Application.id Then
      WaitQueue.Remove(Counter)
      Continue
    Endif

    If MyWait.sym.SymName = "#newvar" Then                 ' NotifyNew: each variable made since the last call
      DeliverNew(MyWait, aNew)
      Continue
    Endif
    If MyWait.sym.SymName = "#delnotifyq" Then             ' NotifyDeleted: each variable freed since the last call
      DeliverDeleted(MyWait, aDeleted)
      Continue
    Endif
    If Not bChanged Then Continue

    Dim oldtime As Float = MyWait.OldTime
    Dim writetime As Float = MyWait.sym.getLastWrite()

    If bAll Then                                            ' no reliable events: the write time tells
      If OldTime = writetime Then Continue
    Else If Not cChanged.Exist(CStr(MyWait.sym.SlotIndex) & ":" & CStr(MyWait.sym.SlotGen)) Then
      Continue
    Endif

    MyWait.oldtime = writetime

    'Error "signal : Dispatching updated info";; MyWait.Method

    vReturn = MyWait.sym.ShmRead()

    Try Object.Call(MyWait.CallBack, MyWait.Method, [vReturn, SharedMem.PlainName(MyWait.sym.SymName)])   ' path, not this tree's path@tag
    If Error Then Print #File.Err, "SharedMem notify "; MyWait.Method; " error: "; Error.Text

    If MyWait.timeout >= 0 Then    ' this is a one shot for the notification

      RemoveWaiter(MyWait.sym)
      WaitQueue.Remove(Counter)    ' this sets it for delete

    Endif

  Next

  'If WaitQueue.Length = 0 Then Signal(ChangeSignal, zValue)

Catch
  Print #File.Err, "SharedMem notify error pid = "; getpid(); " "; Error.Text; " "; Error.Where

End

'' The address of the data of a block from ShmAlloc: after its allocation header. Not AddrData: it skips the
'' type byte at the start, the data then ran one byte past the block into the header of the next one
Fast Unsafe Private Sub QData(pBlock As Pointer) As Pointer

  Return SharedMem.UserMem.AddrReal(pBlock) + SharedMem.AllocHeaderLen

End

'' SharedMem._put holds the lock: add an event for variable oSym, QKindNew or QKindChanged, to the queue of
'' every process in the list of oList: the variable itself for a change, #newvar for a new variable.
'' SignalQueued wakes them after the lock. Raises nothing
Fast Unsafe Public Sub QueueEvent(iKind As Integer, oSym As SharedMemSymbol, oList As SharedMemSymbol)

  Dim pList, pPids, pQ, pEntry As Pointer
  Dim iPid, iCount, i As Integer
  Dim iWritten, iRead As Long

  If $pQTable = 0 Or If oSym = Null Or If oSym.SlotIndex < 0 Then Return
  pList = SharedMem.SymbolTable.Waiters(oList)
  If pList = 0 Then Return
  pPids = QData(pList)
  iCount = Integer@(pPids)
  i = 0
  While i < iCount
    iPid = Integer@(pPids + 8 + i * 4)
    pQ = QueueOf(iPid)
    If pQ = 0 Then                                          ' no queue: the process ended without End
      If Not Exist("/proc/" & CStr(iPid)) Then
        Dec iCount
        Integer@(pPids + 8 + i * 4) = Integer@(pPids + 8 + iCount * 4)
        Integer@(pPids) = iCount
        Continue
      Endif
      Inc i
      Continue
    Endif
    pQ = QData(pQ)
    iWritten = Long@(pQ)
    iRead = Long@(pQ + 8)
    If iKind = QKindChanged And If Long@(pQ + 24) >= iRead And If iWritten > iRead Then   ' the same change not read yet: the reader gives the value once
      pEntry = pQ + QHeader + CInt(Long@(pQ + 24) Mod QSize) * QEntry
      If Integer@(pEntry) = iKind And If Integer@(pEntry + 4) = oSym.SlotIndex And If Long@(pEntry + 8) = oSym.SlotGen Then
        Inc i
        Continue
      Endif
    Endif
    MakeRoom(pQ, 1)
    iWritten = Long@(pQ)
    pEntry = pQ + QHeader + CInt(iWritten Mod QSize) * QEntry
    Integer@(pEntry) = iKind
    Integer@(pEntry + 4) = oSym.SlotIndex
    Long@(pEntry + 8) = oSym.SlotGen
    Long@(pQ + 24) = iWritten
    Long@(pQ) = iWritten + 1
    If iKind = QKindNew Then $aSignalNew.Add(iPid) Else $aSignalChanged.Add(iPid)
    Inc i
  Wend

End

'' True when a process is in the list of oSym. The caller holds the SharedMem lock
Fast Unsafe Public Sub HasWaiters(oSym As SharedMemSymbol) As Boolean

  Dim pList As Pointer = SharedMem.SymbolTable.Waiters(oSym)

  If pList = 0 Then Return False
  Return Integer@(QData(pList)) > 0

End

'' The number of processes in the list of oSym
Public Sub WaiterCount(oSym As SharedMemSymbol) As Integer

  Dim iCount As Integer

  If Not SharedMem.TableLock() Then Return 0
  If HasWaiters(oSym) Then iCount = Integer@(QData(SharedMem.SymbolTable.Waiters(oSym)))
  SharedMem.TableUnlock()
  Return iCount

End

'' The queue block of process iPid, 0 when it has none
Fast Unsafe Private Sub QueueOf(iPid As Integer) As Pointer

  Dim pTable As Pointer

  If $pQTable = 0 Then Return 0
  pTable = QData($pQTable)
  For i As Integer = 0 To QSlots - 1
    If Integer@(pTable + i * 16) = iPid Then Return Pointer@(pTable + i * 16 + 8)
  Next
  Return 0

End

'' Our waits by variable, forgotten in a forked Task: they are its parent's
Private Sub MyWaits() As Collection

  If $iMyWaitsPid <> getpid() Then
    $cMyWaits = New Collection
    $iMyWaitsPid = getpid()
  Endif
  Return $cMyWaits

End

'' One more wait of ours for oSym: the first puts our pid in its list
Private Sub AddWaiter(oSym As SharedMemSymbol)

  Dim sKey As String = CStr(oSym.SlotIndex) & ":" & CStr(oSym.SlotGen)
  Dim pList, pPids, pNew As Pointer
  Dim iCount, iCap As Integer

  If MyWaits().Exist(sKey) Then
    MyWaits()[sKey] = MyWaits()[sKey] + 1
    Return                                                  ' our pid is in the list already
  Endif
  MyWaits()[sKey] = 1
  If Not SharedMem.TableLock() Then Error.Raise(SharedMem.LockError)
  pList = SharedMem.SymbolTable.Waiters(oSym)
  If pList = 0 Then
    pList = SharedMem.ShmTryAlloc(SharedMem.AllocHeaderLen + 8 + WaitersFirst * 4)
    If pList = 0 Then
      SharedMem.TableUnlock()
      Error.Raise("Notify: " & SharedMem.LastAllocError)
    Endif
    Integer@(QData(pList)) = 0
    Integer@(QData(pList) + 4) = WaitersFirst
    SharedMem.SymbolTable.SetWaiters(oSym, pList)
  Endif
  pPids = QData(pList)
  iCount = Integer@(pPids)
  iCap = Integer@(pPids + 4)
  For i As Integer = 0 To iCount - 1
    If Integer@(pPids + 8 + i * 4) = getpid() Then          ' already there
      SharedMem.TableUnlock()
      Return
    Endif
  Next
  If iCount >= iCap Then                                    ' full: a list twice as long
    pNew = SharedMem.ShmTryAlloc(SharedMem.AllocHeaderLen + 8 + iCap * 2 * 4)
    If pNew = 0 Then
      SharedMem.TableUnlock()
      Error.Raise("Notify: " & SharedMem.LastAllocError)
    Endif
    pPids = QData(pList)                                    ' the allocation may have moved memory that grows
    For i = 0 To iCount - 1
      Integer@(QData(pNew) + 8 + i * 4) = Integer@(pPids + 8 + i * 4)
    Next
    Integer@(QData(pNew)) = iCount
    Integer@(QData(pNew) + 4) = iCap * 2
    SharedMem.SymbolTable.SetWaiters(oSym, pNew)
    SharedMem.ShmFree(pList)
    pList = pNew
    pPids = QData(pList)
  Endif
  Integer@(pPids + 8 + iCount * 4) = getpid()
  Integer@(pPids) = iCount + 1
  SharedMem.TableUnlock()

End

'' One wait of ours for oSym less: the last takes our pid out of its list, an empty list is freed
Private Sub RemoveWaiter(oSym As SharedMemSymbol)

  Dim sKey As String = CStr(oSym.SlotIndex) & ":" & CStr(oSym.SlotGen)
  Dim pList, pPids As Pointer
  Dim iCount As Integer

  If Not MyWaits().Exist(sKey) Then Return
  MyWaits()[sKey] = MyWaits()[sKey] - 1
  If MyWaits()[sKey] > 0 Then Return
  MyWaits().Remove(sKey)
  If Not SharedMem.TableLock() Then Return
  pList = SharedMem.SymbolTable.Waiters(oSym)
  If pList <> 0 Then
    pPids = QData(pList)
    iCount = Integer@(pPids)
    For i As Integer = 0 To iCount - 1
      If Integer@(pPids + 8 + i * 4) = getpid() Then
        Dec iCount
        Integer@(pPids + 8 + i * 4) = Integer@(pPids + 8 + iCount * 4)
        Integer@(pPids) = iCount
        Break
      Endif
    Next
    If iCount = 0 Then
      SharedMem.SymbolTable.SetWaiters(oSym, 0)
      SharedMem.ShmFree(pList)
    Endif
  Endif
  SharedMem.TableUnlock()

End

'' The number of entries of the event starting at entry n of queue data pQ
Fast Unsafe Private Sub EventSize(pQ As Pointer, n As Long) As Integer

  Dim pEntry As Pointer = pQ + QHeader + CInt(n Mod QSize) * QEntry

  If Integer@(pEntry) = QKindDeleted Then Return 1 + (Integer@(pEntry + 4) + QEntry) \ QEntry
  Return 1

End

'' Drop the oldest events of queue data pQ until iEntries entries are free, counted by kind
Fast Unsafe Private Sub MakeRoom(pQ As Pointer, iEntries As Integer)

  Dim iRead As Long
  Dim pEntry As Pointer

  While Long@(pQ) - Long@(pQ + 8) + iEntries > QSize
    iRead = Long@(pQ + 8)
    pEntry = pQ + QHeader + CInt(iRead Mod QSize) * QEntry
    If Integer@(pEntry) = QKindChanged Then
      Integer@(pQ + 20) = Integer@(pQ + 20) + 1
    Else
      Integer@(pQ + 16) = Integer@(pQ + 16) + 1
    Endif
    Long@(pQ + 8) = iRead + EventSize(pQ, iRead)
  Wend

End

'' SharedMem.free holds the lock: add a deleted event with sName to the queue of every process in the list of
'' oList, #delnotifyq. SignalQueued wakes them after the lock. Raises nothing
Fast Unsafe Public Sub QueueDeleted(sName As String, oList As SharedMemSymbol)

  Dim pList, pPids, pQ, pEntry As Pointer
  Dim iPid, iCount, i, iLen, iEntries, k As Integer
  Dim iWritten, iBase As Long

  If $pQTable = 0 Or If oList = Null Then Return
  pList = SharedMem.SymbolTable.Waiters(oList)
  If pList = 0 Then Return
  iLen = Len(sName)
  If iLen > 127 Then iLen = 127
  iEntries = 1 + (iLen + QEntry) \ QEntry                    ' the header, then the name and its zero
  pPids = QData(pList)
  iCount = Integer@(pPids)
  i = 0
  While i < iCount
    iPid = Integer@(pPids + 8 + i * 4)
    pQ = QueueOf(iPid)
    If pQ = 0 Then                                          ' no queue: the process ended without End
      If Not Exist("/proc/" & CStr(iPid)) Then
        Dec iCount
        Integer@(pPids + 8 + i * 4) = Integer@(pPids + 8 + iCount * 4)
        Integer@(pPids) = iCount
        Continue
      Endif
      Inc i
      Continue
    Endif
    pQ = QData(pQ)
    MakeRoom(pQ, iEntries)
    iWritten = Long@(pQ)
    pEntry = pQ + QHeader + CInt(iWritten Mod QSize) * QEntry
    Integer@(pEntry) = QKindDeleted
    Integer@(pEntry + 4) = iLen
    Long@(pEntry + 8) = 0
    iBase = (iWritten + 1) * QEntry                          ' the name, byte by byte: it may wrap round the end
    For k = 0 To iLen
      If k < iLen Then
        Byte@(pQ + QHeader + CInt((iBase + k) Mod (QSize * QEntry))) = Asc(sName, k + 1)
      Else
        Byte@(pQ + QHeader + CInt((iBase + k) Mod (QSize * QEntry))) = 0
      Endif
    Next
    Long@(pQ + 24) = iWritten
    Long@(pQ) = iWritten + iEntries
    $aSignalDeleted.Add(iPid)
    Inc i
  Wend

End

'' Write the keys of the events QueueEvent added to the pipes of their processes, after the lock
Public Sub SignalQueued()

  Dim iPid As Integer

  For Each iPid In $aSignalNew
    NotifyPid(iPid, KeyNew)
  Next
  For Each iPid In $aSignalChanged
    NotifyPid(iPid, KeyChanged)
  Next
  For Each iPid In $aSignalDeleted
    NotifyPid(iPid, KeyDeleted)
  Next
  $aSignalNew.Clear()
  $aSignalChanged.Clear()
  $aSignalDeleted.Clear()

End

'' Make our event queue and put it in the table. A queue left by a process that ended without End is freed
'' and its entry used again
Private Sub OpenQueue()

  Dim pTable, pSlot As Pointer
  Dim iPid As Integer
  Dim iFree As Integer = -1
  Dim pQ As Pointer

  If $iMyQPid <> getpid() Then $pMyQ = 0                    ' a forked Task: the queue is its parent's
  If $pMyQ <> 0 Or If $pQTable = 0 Then Return
  If Not SharedMem.TableLock() Then Error.Raise(SharedMem.LockError)
  pTable = QData($pQTable)
  For i As Integer = 0 To QSlots - 1
    pSlot = pTable + i * 16
    iPid = Integer@(pSlot)
    If iPid > 0 And If Not Exist("/proc/" & CStr(iPid)) Then  ' its process is gone
      SharedMem.ShmFree(Pointer@(pSlot + 8))
      Integer@(pSlot) = 0
      iPid = 0
    Endif
    If iPid = 0 And If iFree < 0 Then iFree = i
  Next
  If iFree < 0 Then
    SharedMem.TableUnlock()
    Error.Raise("Notify: " & CStr(QSlots) & " processes already wait for notifications")
  Endif
  pQ = SharedMem.ShmTryAlloc(SharedMem.AllocHeaderLen + QHeader + QSize * QEntry)
  If pQ = 0 Then
    SharedMem.TableUnlock()
    Error.Raise("Notify: " & SharedMem.LastAllocError)
  Endif
  For i = 0 To 3
    Long@(QData(pQ) + i * 8) = 0
  Next
  pTable = QData($pQTable)             ' the allocation may have moved memory that grows
  pSlot = pTable + iFree * 16
  Pointer@(pSlot + 8) = pQ
  Integer@(pSlot + 4) = 0
  Integer@(pSlot) = getpid()
  SharedMem.TableUnlock()
  $pMyQ = pQ
  $iMyQPid = getpid()

End

'' Close our queue when we have no wait left
Private Sub CloseQueueIfIdle()

  For Each MyWait As WaitHeader In WaitQueue
    If MyWait.pid = getpid() Then Return
  Next
  CloseQueue()

End

'' Take our queue out of the table and free it
Private Sub CloseQueue()

  Dim pTable, pSlot As Pointer

  If $iMyQPid <> getpid() Then $pMyQ = 0
  If $pMyQ = 0 Or If $pQTable = 0 Then Return
  If Not SharedMem.TableLock() Then Return
  pTable = QData($pQTable)
  For i As Integer = 0 To QSlots - 1
    pSlot = pTable + i * 16
    If Integer@(pSlot) = getpid() Then
      Integer@(pSlot) = 0
      SharedMem.ShmFree(Pointer@(pSlot + 8))
    Endif
  Next
  SharedMem.TableUnlock()
  $pMyQ = 0

End

'' Take the events out of our queue: the names of the new variables into aNew, slot:generation of the changed
'' ones into cChanged, the names of the deleted ones into aDeleted. True when change events were dropped
'' because the queue was full
Private Sub TakeEvents(aNew As String[], cChanged As Collection, aDeleted As String[]) As Boolean

  Dim pQ, pEntry As Pointer
  Dim iWritten, n, iBase As Long
  Dim iDroppedNew, iDroppedChanged, iLen, k As Integer
  Dim oSym As SharedMemSymbol
  Dim sName As String

  If $iMyQPid <> getpid() Or If $pMyQ = 0 Then Return False
  If Not SharedMem.TableLock() Then Return False
  pQ = QData($pMyQ)
  iWritten = Long@(pQ)
  n = Long@(pQ + 8)
  While n < iWritten
    pEntry = pQ + QHeader + CInt(n Mod QSize) * QEntry
    Select Case Integer@(pEntry)
      Case QKindNew
        oSym = SharedMem.SymbolTable.SymbolAt(Integer@(pEntry + 4), Long@(pEntry + 8))
        If oSym <> Null Then aNew.Add(oSym.SymName)         ' Null: freed again meanwhile
      Case QKindChanged
        cChanged[CStr(Integer@(pEntry + 4)) & ":" & CStr(Long@(pEntry + 8))] = True
      Case QKindDeleted
        iLen = Integer@(pEntry + 4)
        iBase = (n + 1) * QEntry
        sName = ""
        For k = 0 To iLen - 1
          sName &= Chr(Byte@(pQ + QHeader + CInt((iBase + k) Mod (QSize * QEntry))))
        Next
        aDeleted.Add(sName)
    End Select
    n += EventSize(pQ, n)
  Wend
  Long@(pQ + 8) = iWritten
  iDroppedNew = Integer@(pQ + 16)
  iDroppedChanged = Integer@(pQ + 20)
  Long@(pQ + 16) = 0
  SharedMem.TableUnlock()
  If iDroppedNew > 0 Then Print #File.Err, "SharedMem notify: "; iDroppedNew; " new or deleted variables were not reported, the queue of "; QSize; " entries was full"
  Return iDroppedChanged > 0

End

'' False for the variables the library makes for itself, and the private copies of other gsh trees
Private Sub ShowNew(sName As String) As Boolean

  Dim iAt As Integer

  If sName = "#newvar" Or If sName = "#notifyq" Or If sName = "#delnotifyq" Or If sName Begins "#private@" Then Return False
  iAt = RInStr(sName, "@")
  If iAt > 1 And If SharedMem.PlainName(sName) = sName And If IsDigit(Mid(sName, iAt + 1)) Then Return False   ' path@pid of another tree
  Return True

End

'' Call the NotifyDeleted function of MyWait once for each freed variable, with its name
Private Sub DeliverDeleted(MyWait As WaitHeader, aNames As String[])

  For Each sName As String In aNames
    If Not ShowNew(sName) Then Continue
    Try Object.Call(MyWait.CallBack, MyWait.Method, [SharedMem.PlainName(sName)])   ' path, not this tree's path@tag
    If Error Then Print #File.Err, "SharedMem notify "; MyWait.Method; " error: "; Error.Text
  Next

End

'' Call the NotifyNew function of MyWait once for each new variable, with its value and name
Private Sub DeliverNew(MyWait As WaitHeader, aNames As String[])

  Dim vValue As Variant

  For Each sName As String In aNames
    If Not ShowNew(sName) Then Continue
    If Not SharedMem.Exist(sName) Then Continue             ' freed again meanwhile
    vValue = SharedMem[sName]
    Try Object.Call(MyWait.CallBack, MyWait.Method, [vValue, SharedMem.PlainName(sName)])   ' path, not this tree's path@tag
    If Error Then Print #File.Err, "SharedMem notify "; MyWait.Method; " error: "; Error.Text
  Next

End
