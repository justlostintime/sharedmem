' Gambas module file

Fast Unsafe
Public Const LoopCount As Integer = 100000      ' operations per test, a speed test needs enough of them to measure
TestSharedMem As Boolean = True                 ' run the test

Public Sub main()

  Dim tstart As Float
  Dim j As Integer
  Dim sj As String
  Dim i As Integer
  Dim iBad As Integer

  If TestSharedMem Then
    With sharedmem
      Print "Begin Speed Access Test Shared Memory, "; LoopCount; " operations per test ++++++++++++++++++++++++++++++++++++"

      .begin(128000)

      !integer = CInteger(0)

      '**************************************************************************************************************************
      ' a variable that changes type is freed and made again each time, so this one is slow: a tenth of the loops
      iBad = 0
      tstart = Timer
      For i = 1 To LoopCount \ 10
        !integer = i
        !integer = "this is a long string"
        !integer = i
        If !integer <> i Then Inc iBad
      Next
      Result("Integer -> string -> integer, type change", Timer - tstart, (LoopCount \ 10) * 3, iBad)

      '**************************************************************************************************************************
      tstart = Timer
      For i = 1 To LoopCount
        !ThisString = "This is a little message to be saved"
      Next
      Result("String write   SharedMem!Name", Timer - tstart, LoopCount, 0)
      '**************************************************************************************************************************
      iBad = 0
      tstart = Timer
      For i = 1 To LoopCount
        sj = !ThisString
        If Len(sj) <> 36 Then Inc iBad
      Next
      Result("String read    SharedMem!Name", Timer - tstart, LoopCount, iBad)
      '**************************************************************************************************************************
      iBad = 0
      tstart = Timer
      For i = 1 To LoopCount
        sj = .["ThisString"]
        If Len(sj) <> 36 Then Inc iBad
      Next
      Result("String read    SharedMem[\"Name\"]", Timer - tstart, LoopCount, iBad)
      '**************************************************************************************************************************
      tstart = Timer
      For i = 1 To LoopCount
        !ThisNumber = i
      Next
      Result("Integer write  SharedMem!Name", Timer - tstart, LoopCount, If(!ThisNumber = LoopCount, 0, 1))
      '**************************************************************************************************************************
      iBad = 0
      tstart = Timer
      For i = 1 To LoopCount
        j = !ThisNumber
        If j <> LoopCount Then Inc iBad
      Next
      Result("Integer read   SharedMem!Name", Timer - tstart, LoopCount, iBad)
      '**************************************************************************************************************************
      tstart = Timer
      For i = 1 To LoopCount
        !ThisString = "a string of length " & CStr(i Mod 500)   ' changing length, it stays in its storage block
      Next
      Result("String write, changing length", Timer - tstart, LoopCount, If(!ThisString = "a string of length " & CStr(LoopCount Mod 500), 0, 1))

      Print "Number of shared variables ="; .Count

      PrintVariables(.Vars)

      .End()
      Print "End Speed Access Test ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++"

    End With
  Endif
  Quit 0

End

'' One line of results: the time of each operation, operations per second, and wrong values read back
Private Sub Result(sTest As String, fSeconds As Float, iOperations As Integer, iBad As Integer)

  Print Left(sTest & Space(44), 44); Format(fSeconds / iOperations * 1000000, "##0.00"); " us   "; Format(iOperations / fSeconds, "#######0"); " per second"; IIf(iBad > 0, "   WRONG VALUES: " & CStr(iBad), "")

End

'' The variables and their values, without the ones the library keeps for itself
Sub PrintVariables(thearray As Collection)

  Print "\nSymbol Table \n"
  For Each v As Variant In thearray
    If thearray.key Begins "#" Then Continue
    Print thearray.key; " = "; v
  Next
  Print "-----------------------------------"

End
