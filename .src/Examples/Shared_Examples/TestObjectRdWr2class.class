' Gambas class file

Inherits SharedClass

Public x As Integer = 100
Public y As String = "2 - This is a silly string"
Public pp As String[] = ["2 - This is ", "a", "big", "thing", "to", "do"]
Property setx As Integer


Public Sub callme()

  Print "Hello"
  Print pp.Join(" ")
  Print y
  Print "x="; x

End

Private Function setx_Read() As Integer

  Return x

End

Private Sub setx_Write(Value As Integer)

  x = value

End
