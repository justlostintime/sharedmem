' Gambas module file

'Fast Unsafe
' Unnamed memory grows when it is full: 1001 variables in a 20000 byte block. A named segment does not grow,
' there the same loop stops with "SharedMem is full"

Public Sub main()

  Dim i As Integer

  With sharedmem
    .begin(20000)
    For i = 0 To 1000
      .["Var" & CStr(i)] = i
    Next
    .End()
  End With
  Print "Completed"
  Quit 0

End
