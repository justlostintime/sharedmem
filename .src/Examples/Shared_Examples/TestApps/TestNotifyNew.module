' Gambas module file

'Fast Unsafe
' notify New Is Not working

Public Sub main()

  With SharedMem
    .Begin()
    .NotifyNew(Me)
    Wait 0.01
    .a = 100
    .b = 100
    Wait 5
    .End()
  End With

End

Public Sub newvar_created(value As Variant, Name As String)

  With sharedmem
    Print "new variable  created:";; Name;; value
  End With

End



